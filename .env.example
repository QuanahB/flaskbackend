# Copy to `.env` in this folder. Never commit real keys.

SECRET_KEY=dev-only-change-me

# Stripe Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen --forward-to localhost:5000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe sends the shopper after pay / cancel
FRONTEND_ORIGIN=http://localhost:5173

# Render Postgres Internal Database URL. Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/store
